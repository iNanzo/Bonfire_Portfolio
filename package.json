{
  "name": "newton-hoang-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "model": "node tools/build-model.mjs",
    "model:knight": "node tools/build-model.mjs knight",
    "screenshots": "node tools/import-screenshots.mjs",
    "link": "node tools/link-bridge.mjs",
    "admin": "vite --config admin/vite.config.js",
    "admin:build": "vite build --config admin/vite.config.js",
    "admin:deploy": "npm run admin:build && npx --yes wrangler@4 deploy --config admin/wrangler.toml",
    "admin:test": "node --test \"admin/test/*.test.mjs\"",
    "test": "node --test \"test/*.test.mjs\"",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run admin:test"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
