{
  // Type checking for the plain-JS modules (npm run typecheck): TypeScript reads their
  // JSDoc; nothing is compiled. Every module of the site, Bonfire Live, the Painter and the
  // admin is checked, a new one too, with nothing to list. A module that doesn't check clean
  // yet says so on its first line (// @ts-nocheck, with its error count); fixing one means
  // deleting that line, and test/typecheckDebt.test.mjs keeps the count from growing. Three.js
  // ships no types, so its values are `any`; `vite/client` types import.meta.env and asset
  // imports.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "admin/**/*.js"],
  // (The admin's Vite config runs in Node, which the browser lib above doesn't type.)
  "exclude": ["admin/vite.config.js", "admin/dist/**", "dist/**"]
}
