{
  // Type checking for the plain-JS modules (npm run typecheck): TypeScript reads their
  // JSDoc; nothing is compiled. It started with the logic that has no DOM or WebGL in it
  // (audio analysis, tempo, sections, palettes, routes, links, content rules) and grows from
  // there: a module joins the list once it (and what it imports) checks clean, and a new
  // module joins when it's written. Three.js ships no types, so its values are `any`;
  // `vite/client` types `import.meta.env` and asset imports.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "files": [
    "src/math.js",
    "src/html.js",
    "src/modes.js",
    "src/text.js",
    "src/routes.js",
    "src/paletteGen.js",
    "src/contentRules.js",
    "src/ruleBasics.js",
    "src/scenes.js",
    "src/sceneStore.js",
    "src/sceneries.js",
    "src/knightNames.js",
    "src/404.js",
    "src/content.js",
    "src/effects.js",
    "src/effectsDefaults.js",
    "src/elements.js",
    "src/palette.js",
    "src/render.js",
    "src/seo.js",
    "src/seoPages.js",
    "src/ui/pixelArt.js",
    "src/ui/logo.js",
    "src/ui/renderMenu.js",
