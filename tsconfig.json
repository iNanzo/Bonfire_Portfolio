{
  // Type checking for the plain-JS modules (npm run typecheck): TypeScript reads their
  // JSDoc; nothing is compiled. It covers the logic that has no DOM or WebGL in it (audio
  // analysis, tempo, sections, palettes, routes, links, content rules) and grows from there.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "files": [
    "src/math.js",
    "src/html.js",
    "src/routes.js",
    "src/paletteGen.js",
    "src/contentRules.js",
    "src/ruleBasics.js",
    "src/scenes.js",
    "src/sceneStore.js",
    "src/sceneries.js",
    "src/knightNames.js",
    "src/ui/pixelArt.js",
    "src/ui/logo.js",
    "src/ui/renderMenu.js",
    "src/ui/fields.js",
    "src/ui/orbit.js",
    "src/painter/history.js",
    "src/painter/beat.js",
    "src/painter/panel.js",
    "src/painter/cameraRig.js",
    "src/visualizer/analyser.js",
    "src/visualizer/tempo.js",
    "src/visualizer/sections.js",
    "src/visualizer/cameraEase.js",
    "src/visualizer/record.js",
    "src/visualizer/midi.js",
    "src/visualizer/render.js",
    "src/visualizer/knightShow.js",
    "src/visualizer/looks.js",
    "src/visualizer/clearing.js",
    "src/visualizer/layered.js",
    "src/visualizer/sceneLoop.js",
    "src/visualizer/scenePlayer.js",
    "src/visualizer/density.js",
    "src/bonfire/bladeMotion.js",
    "src/bonfire/knightPose.js",
    "src/bonfire/knightPlaces.js",
    "src/bonfire/steel.js",
    "src/bonfire/knightStyles.js"
  ]
}
